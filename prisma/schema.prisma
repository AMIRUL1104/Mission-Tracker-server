// This is your Prisma schema file,

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String   
  age       Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  months    Month[]  // Relation to Month
}


model Month {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  monthKey  String   // Example: "2026-03" (YYYY-MM format)
  year      Int      // 2026
  month     Int      // 3 (March)
  status    String   @default("active") // "active", "archived"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  priorities Priority[] // Priority-এর সাথে রিলেশন

  // Composite Unique constraint: Ekjon user-er specific year & month ektai thakbe
  @@unique([userId, year, month])
  @@unique([userId, monthKey])
}

model Priority {
  id          String      @id @default(uuid())
  monthId     String
  month       Month       @relation(fields: [monthId], references: [id], onDelete: Cascade)
  
  title       String
  description String?
  target      Int         @default(100) // Target completion percentage (e.g. 100%)
  progress    Int         @default(0)   // Calculated or manual progress
  position    Int         @default(0)   // Sorting order
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  milestones  Milestone[] // Milestone-এর সাথে রিলেশন
}

model Milestone {
  id          String   @id @default(uuid())
  priorityId  String
  priority    Priority @relation(fields: [priorityId], references: [id], onDelete: Cascade)
  
  title       String
  completed   Boolean  @default(false)
  position    Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}